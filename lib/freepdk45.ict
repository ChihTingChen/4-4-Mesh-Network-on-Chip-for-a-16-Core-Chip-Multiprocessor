# FreePDK45 interconnect stack for Innovus cap-table generation.
# Heights / thicknesses / k from ncsu_basekit/techfile/calibre/calibrexRC.rul,
# resistivity = LEF sheet resistance x thickness, via R from LEF contactResistance.
process "FreePDK45" {
    background_dielectric_constant 2.5
}
dielectric "field_base_diel" {
    dielectric_constant 3.9
    height 0.0
    thickness 0.2
}
dielectric "imd" {
    dielectric_constant 2.5
    height 0.2
    thickness 13.89
}

conductor "metal1" {
    min_spacing 0.065
    min_width 0.065
    height 0.37
    thickness 0.13
    resistivity 0.0494
}
conductor "metal2" {
    min_spacing 0.075
    min_width 0.07
    height 0.62
    thickness 0.14
    resistivity 0.035
}
conductor "metal3" {
    min_spacing 0.07
    min_width 0.07
    height 0.88
    thickness 0.14
    resistivity 0.035
}
conductor "metal4" {
    min_spacing 0.14
    min_width 0.14
    height 1.14
    thickness 0.28
    resistivity 0.07
}
conductor "metal5" {
    min_spacing 0.14
    min_width 0.14
    height 1.71
    thickness 0.28
    resistivity 0.07
}
conductor "metal6" {
    min_spacing 0.14
    min_width 0.14
    height 2.28
    thickness 0.28
    resistivity 0.07
}
conductor "metal7" {
    min_spacing 0.4
    min_width 0.4
    height 2.85
    thickness 0.8
    resistivity 0.2
}
conductor "metal8" {
    min_spacing 0.4
    min_width 0.4
    height 4.47
    thickness 0.8
    resistivity 0.2
}
conductor "metal9" {
    min_spacing 0.8
    min_width 0.8
    height 6.09
    thickness 2.0
    resistivity 0.42
}
conductor "metal10" {
    min_spacing 0.8
    min_width 0.8
    height 10.09
    thickness 2.0
    resistivity 0.42
}

via "via1" {
    top_layer metal2
    bottom_layer metal1
    contact_resistance 5.69
}
via "via2" {
    top_layer metal3
    bottom_layer metal2
    contact_resistance 11.39
}
via "via3" {
    top_layer metal4
    bottom_layer metal3
    contact_resistance 16.73
}
via "via4" {
    top_layer metal5
    bottom_layer metal4
    contact_resistance 21.44
}
via "via5" {
    top_layer metal6
    bottom_layer metal5
    contact_resistance 24.08
}
via "via6" {
    top_layer metal7
    bottom_layer metal6
    contact_resistance 11.39
}
via "via7" {
    top_layer metal8
    bottom_layer metal7
    contact_resistance 5.69
}
via "via8" {
    top_layer metal9
    bottom_layer metal8
    contact_resistance 16.73
}
via "via9" {
    top_layer metal10
    bottom_layer metal9
    contact_resistance 21.44
}
